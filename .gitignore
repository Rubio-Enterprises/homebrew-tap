.DS_Store

.DS_Store
.envrc.local
# Use .envrc.local for machine-local values
*.log
node_modules/
dist/
build/
coverage/
reports/

# .claude/: ignore local state but keep the committed settings, hooks, commands and agents;
# !.claude/ first, so the negations work under a global .claude/ ignore.
!.claude/
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/commands/
!.claude/agents/

# Per-stack
.standards/
# Personal lefthook overrides
lefthook-local.yml
